generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// DumperPro Online - yuklenen dosyalar ve analiz sonuclari
// ----------------------------------------------------------------------------

model Upload {
  id        String    @id // crypto.randomUUID() (dosya adinda da kullanilir)
  fileName  String    // orijinal dosya adi
  savedPath String    // storage/uploads/<id>__<safeName> | klasorde "-"
  size      Int       // bayt
  mime      String?
  source    String    @default("upload") // upload | extract | folder
  parentId  String?   // APK icinden cikarilan dosyada: ana yukleme id'si; klasor grubunda: klasor kaydi
  relPath   String?   // klasor yuklemesinde: orijinal goreceli yol (klasor/dosya.ext)
  status    String    @default("pending") // analyzing | done | error
  error     String?
  createdAt DateTime  @default(now())
  analysis  Analysis?

  @@index([createdAt])
  @@index([parentId])
}

model Analysis {
  id            String   @id @default(cuid())
  uploadId      String   @unique
  upload        Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  kind          String   // pe | apk | zip | elf | dex | unknown
  engine        String?  // UE4 | UE5 | Unity | Godot | Source | ...
  engineVersion String?  // 4.27.2 / 5.3.2 ...
  summary       String   // tam JSON sonuc
  report        String   // insan okur TXT raporu
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// DumperPro ice aktarma: Windows C++ aracindan (DumperPro.exe) gelen JSON /
// TXT sonuc dosyalari (names.json, objects.json, functions.json, result.json,
// Names.txt, Objects.txt, funcs.txt) normalize edilerek burada saklanir.
// ----------------------------------------------------------------------------
model DumperProImport {
  id             String   @id @default(cuid())
  label          String
  toolVersion    String?
  mode           String?
  target         String?
  game           String?
  ueVersion      String?
  moduleName     String?
  moduleBase     String?
  status         String   @default("full")
  namesJson      String?
  objectsJson    String?
  functionsJson  String?
  namesCount     Int      @default(0)
  objectsCount   Int      @default(0)
  functionsCount Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([createdAt])
}
